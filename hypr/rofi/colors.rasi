* {
  /* friendly aliases used throughout the rofi configs */
  background-color: #1c1c1e;
  background-alt:   #3a3a40;
  foreground:       #d4d4d8;
  selected:         #45454e;
  border-color:     #6e6e78;

  /* every color key from style.json, verbatim */
  primary: #5c9dff;
  secondary: #b39dff;
  danger: #ff6b6b;
  warning: #ffcc00;
  ok: #4caf50;
  active: #45454e;
  inactive: #6a6a72;
  background: #1c1c1e;
  background-light: #3a3a40;
  background-dark: #2a2a2e;
  border: #6e6e78;
  border-light: #5a6b9c;
  border-dark: #241b40;
  text: #d4d4d8;
  text-secondary: #6a6a72;
  text-light: #ffffff;
  text-dark: #1c1c1e;

  /* non-color style.json values. radius/gap/padding are emitted as
     px distances (not bare numbers) so they can be used directly in
     border-radius/padding/spacing/margin properties. */
  font-family: "Monospace";
  font-size: 12;
  radius: 0px;
  gap: 5px;
  padding: 10px;

  /* combined font string, and applied directly here so every widget in
     any rofi config that imports this file gets it by default (same
     mechanism as the color aliases above) */
  font: "Monospace 12";
}
